# Single source of truth for bootstrap tools and platform controllers.
# Keep values exact: floating tags make bootstrap and recovery non-reproducible.

# Management container CLIs
KUBECTL_VERSION=1.34.10
# Registration needs a POSIX shell as well as kubectl; the upstream kubectl
# image is distroless. Pin the tested multi-architecture image by digest.
CLUSTER_REGISTRATION_IMAGE=alpine/k8s:1.34.9@sha256:72c921a10c53ab749674e828ad12b776d006481c852bba7dd89e149ceed666f3
HELM_VERSION=3.21.4
YQ_VERSION=4.53.3
ARGOCD_CLI_VERSION=3.5.1
OPENSTACK_CLIENT_VERSION=10.2.1
MAGNUM_CLIENT_VERSION=4.11.0
OCTAVIA_CLIENT_VERSION=3.14.0
DESIGNATE_CLIENT_VERSION=7.0.0
HEAT_CLIENT_VERSION=5.2.0

# Management-cluster controllers
ARGOCD_CHART_VERSION=10.4.0
CERT_MANAGER_VERSION=1.21.1
CAPI_OPERATOR_VERSION=0.28.0
CAPI_VERSION=1.12.11
CAPO_VERSION=0.14.7
ORC_VERSION=2.6.0
CAAPH_VERSION=0.6.2
KRO_VERSION=0.9.3

# Workload-cluster components (Kubernetes 1.34 release line)
WORKLOAD_KUBERNETES_VERSION=1.34.8
WORKLOAD_IMAGE_ID=18895dd1-6e94-482b-9a62-9573328c7429
WORKLOAD_IMAGE_NAME=ubuntu-jammy-kube-v1.34.8-260518-1604
CALICO_VERSION=3.32.1
OPENSTACK_CLOUD_PROVIDER_VERSION=1.34.1
OPENSTACK_CCM_CHART_VERSION=2.34.2
OPENSTACK_CINDER_CSI_CHART_VERSION=2.34.3
CLUSTER_AUTOSCALER_VERSION=1.34.5
