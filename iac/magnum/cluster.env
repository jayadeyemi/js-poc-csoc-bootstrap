# Shared Jetstream2 Magnum parameters. Environment-specific identity, sizing,
# state, kubeconfig, and Git revisions live under iac/csoc/profiles/.
# No secrets — credentials come from clouds.yaml mounted at runtime.

# OpenStack cloud name in clouds.yaml
OS_CLOUD=openstack
MAGNUM_PROJECT_ID=${MAGNUM_PROJECT_ID:-53f449a040d14cef8512b69e4ad521cd}

# ── Cluster identity ─────────────────────────────────────────────────────────
# An alternate name must always be paired with an alternate MAGNUM_STATE_FILE
# so ownership of an existing management cluster cannot be overwritten.
MAGNUM_CLUSTER_NAME=${MAGNUM_CLUSTER_NAME:-js2-mgmt-cluster}

# Provider-owned public Kubernetes 1.34 template. Never create or publish a
# replacement from this repository.
MAGNUM_TEMPLATE_ID=284de191-b8ea-4dae-9046-6ab982bd1c3a
MAGNUM_TEMPLATE_NAME=kubernetes-1-34-jammy
MAGNUM_IMAGE_ID=18895dd1-6e94-482b-9a62-9573328c7429
MAGNUM_IMAGE_NAME=ubuntu-jammy-kube-v1.34.8-260518-1604

# Per-cluster overrides required because the public template intentionally
# leaves the worker flavor unset.
MAGNUM_MASTER_FLAVOR=${MAGNUM_MASTER_FLAVOR:-m3.quad}
MAGNUM_WORKER_FLAVOR=${MAGNUM_WORKER_FLAVOR:-m3.quad}

# ── Networking ───────────────────────────────────────────────────────────────
MAGNUM_EXTERNAL_NETWORK=public
MAGNUM_EXTERNAL_NETWORK_ID=3fe22c05-6206-4db2-9a13-44f04b6796e6
MAGNUM_FIXED_NETWORK=auto_allocated_network
MAGNUM_FIXED_NETWORK_ID=b1bca63f-e34b-47e5-bf96-565515f38326
MAGNUM_FIXED_SUBNET=auto_allocated_subnet_v4
MAGNUM_FIXED_SUBNET_ID=d676529f-7335-417d-a1e3-283f2411af3b
MAGNUM_FLOATING_IP_ENABLED=true
MAGNUM_MASTER_LB_ENABLED=true

# ── Node counts ──────────────────────────────────────────────────────────────
MAGNUM_MASTER_COUNT=${MAGNUM_MASTER_COUNT:-1}
MAGNUM_NODE_COUNT=${MAGNUM_NODE_COUNT:-1}
MAGNUM_BOOT_VOLUME_SIZE=100
MAGNUM_AUTO_SCALING_ENABLED=true
MAGNUM_MIN_NODE_COUNT=${MAGNUM_MIN_NODE_COUNT:-1}
MAGNUM_MAX_NODE_COUNT=${MAGNUM_MAX_NODE_COUNT:-2}
MAGNUM_EXPECTED_INITIAL_NODES=${MAGNUM_EXPECTED_INITIAL_NODES:-2}

# ── Lifecycle deadlines (seconds) ───────────────────────────────────────────
MAGNUM_WAIT_TIMEOUT=${MAGNUM_WAIT_TIMEOUT:-2700}
MAGNUM_WAIT_INTERVAL=${MAGNUM_WAIT_INTERVAL:-15}
MAGNUM_NO_WORKER_DIAG_AFTER=${MAGNUM_NO_WORKER_DIAG_AFTER:-1200}
MAGNUM_DELETE_TIMEOUT=${MAGNUM_DELETE_TIMEOUT:-1800}
MAGNUM_VERIFY_TIMEOUT=${MAGNUM_VERIFY_TIMEOUT:-300}
MAGNUM_NODEGROUP_UPDATE_TIMEOUT=${MAGNUM_NODEGROUP_UPDATE_TIMEOUT:-600}

# ── SSH key ───────────────────────────────────────────────────────────────────
# Public key name registered in OpenStack: openstack keypair list
MAGNUM_KEYPAIR=jetstream-CSOC-POC
