---
# Example clouds.yaml using OpenStack Application Credentials (recommended).
# Copy this file to clouds.yaml and fill in your values.
# DO NOT commit clouds.yaml to git.

clouds:
  jetstream2:
    auth:
      auth_url: https://js2.jetstream-cloud.org:5000/v3
      application_credential_id: "<YOUR_APP_CREDENTIAL_ID>"
      application_credential_secret: "<YOUR_APP_CREDENTIAL_SECRET>"
    auth_type: v3applicationcredential
    region_name: IU
    interface: public
    identity_api_version: 3

  # Optional: second region (e.g. TACC)
  jetstream2-tacc:
    auth:
      auth_url: https://tacc.jetstream-cloud.org:5000/v3
      application_credential_id: "<YOUR_TACC_APP_CREDENTIAL_ID>"
      application_credential_secret: "<YOUR_TACC_APP_CREDENTIAL_SECRET>"
    auth_type: v3applicationcredential
    region_name: TACC
    interface: public
    identity_api_version: 3
